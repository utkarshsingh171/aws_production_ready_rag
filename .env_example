# AWS user credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application variables
AWS_REGION=
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_MODEL_ID=


LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proj_name


FALLBACK_MODEL=

# Per-deployment limits enforced by the LiteLLM router
DEPLOYMENT_RPM=
DEPLOYMENT_TPM=

# ---------- NEW: Per-user limits ----------
SESSION_MAX_REQUESTS=
USER_RPM=
USER_DAILY_BUDGET_USD=

# ---------- NEW: Cost estimation ----------
# Only used if LiteLLM has no built-in price for the model.
# Set to Nova Lite prices (USD per 1K tokens); check current Bedrock pricing.
COST_INPUT_PER_1K=
COST_OUTPUT_PER_1K=
